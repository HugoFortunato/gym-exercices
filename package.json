    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^10.2.10",
    "@prisma/client": "^5.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "graphql": "^16.12.0",
    "ioredis": "^5.8.2",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
